    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "libphonenumber-js": "^1.12.33",
    "lucide-react": "^0.562.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.69.0",
    "swiper": "^12.1.3",
